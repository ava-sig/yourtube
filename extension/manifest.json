{
  "manifest_version": 3,
  "name": "YourTube Local Feed",
  "version": "0.5.10",
  "description": "Capture rendered YouTube feeds, searches, playlists, channel sections, and browser-visible video metadata for your local YourTube library.",
  "permissions": ["storage", "alarms"],
  "action": { "default_title": "YourTube network mode", "default_popup": "popup.html" },
  "host_permissions": ["http://127.0.0.1:4173/*", "http://localhost:4173/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["capture.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1:4173/*", "http://localhost:4173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
