{
  "manifest_version": 3,
  "name": "YourTube Local Feed",
  "version": "0.5.39",
  "description": "Capture YouTube pages for YourTube and inspect local capture queues and failures.",
  "permissions": ["storage", "alarms", "clipboardWrite", "activeTab"],
  "action": { "default_title": "YourTube capture diagnostics", "default_popup": "popup.html" },
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["capture.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
