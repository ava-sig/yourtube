# Host directories mounted into the container for persistent state and media.
# Keep data on this computer's preferred disk and point media at a USB/external drive if desired.
YOURTUBE_DATA_HOST_PATH=./docker-data
YOURTUBE_MEDIA_HOST_PATH=./docker-media

# Match these to `id -u` and `id -g` on Linux/macOS so the container can write
# to the mounted folders. Typical Linux defaults are 1000/1000; macOS differs.
YOURTUBE_UID=1000
YOURTUBE_GID=1000

# Keep the current default unless you intentionally want stricter download throttling.
YOURTUBE_DOWNLOAD_PROTECTIONS=off
